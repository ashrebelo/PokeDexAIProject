<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PokeDex</title>
  </head>
  <body>
    <%- include('partials/header') %>

    <main>
      <h1>PokeDex</h1>

      <section>
        <ul>
          <% pokemonList.results.forEach((pokemon) => { %>
            <li>
              <a href="/pokemon/<%= pokemon.name %>"><%= pokemon.name %></a>
            </li>
          <% }) %>
        </ul>
      </section>

      <nav>
        <% if (previousPageUrl) { %>
          <a href="<%= previousPageUrl %>">Previous</a>
        <% } %>

        <% if (nextPageUrl) { %>
          <a href="<%= nextPageUrl %>">Next</a>
        <% } %>
      </nav>
    </main>
  </body>
</html>